if (d.blocks && d.blocks.length){
bh = '<div style="margin:8px 0 4px;color:#5096ff;font-size:11px;letter-spacing:2px;font-family:ui-monospace,monospace">BLOCS ANALYSÉS</div>';
d.blocks.slice(0, 20).forEach(b => {
bh += '<div class="block"><span class="lang">['+esc(b.language)+']</span> ' +
'<span class="conf">'+Math.round((b.confidence||0)*100)+'%</span> ' +
