# COUCHE 11 — HANDLER HTTP
# ═══════════════════════════════════════════════════════════════════════════

class Handler(BaseHTTPRequestHandler):
def log_message(self, *args): pass

def _send(self, code, body, ctype="application/json"):
try:
if isinstance(body, str):
body = body.encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", ctype + "; charset=utf-8")
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Content-Length", str(len(body)))
self.end_headers()
self.wfile.write(body)
except (BrokenPipeError, ConnectionResetError):
pass

def _read_json(self) -> Dict:
try:
n = int(self.headers.get("Content-Length", "0"))
if n > 10_000_000:
return {}
raw = self.rfile.read(n)
return json.loads(raw.decode("utf-8"))
except Exception:
return {}

def do_GET(self):
path = self.path.split("?")[0]
if path in ("/", "/index.html"):
return self._send(200, HTML_UI, "text/html")
if path == "/api/health":
return self._send(200, json.dumps(ENGINE.stats(), ensure_ascii=False))
if path == "/api/languages":
return self._send(200, json.dumps({
"detection": Stopwords.languages(),
"count": len(Stopwords.languages()),
}))
if path == "/api/dictionaries":
return self._send(200, json.dumps({
"pairs": [f"{s}→{t}" for (s, t) in Dictionaries.available_pairs()],
"count": len(Dictionaries.available_pairs()),
}))
return self._send(404, json.dumps({"error": "not found"}))

def do_POST(self):
path = self.path.split("?")[0]
data = self._read_json()

if path == "/api/detect":
text = data.get("text", "")
if not text:
return self._send(400, json.dumps({"error": "text missing"}))
return self._send(200, json.dumps(ENGINE.analyze_text(text), ensure_ascii=False))

if path == "/api/detect-multi":
text = data.get("text", "")
if not text:
return self._send(400, json.dumps({"error": "text missing"}))
return self._send(200, json.dumps(ENGINE.analyze_multi(text), ensure_ascii=False))

if path == "/api/analyze-url":
url = data.get("url", "")
if not url:
return self._send(400, json.dumps({"error": "url missing"}))
return self._send(200, json.dumps(ENGINE.analyze_url(url), ensure_ascii=False))

if path == "/api/translate":
text = data.get("text", "")
source = data.get("source", "fr")
target = data.get("target", "en")
if not text:
return self._send(400, json.dumps({"error": "text missing"}))
return self._send(200, json.dumps(ENGINE.translate(text, source, target), ensure_ascii=False))

return self._send(404, json.dumps({"error": "not found"}))


class Server(ThreadingMixIn, HTTPServer):
daemon_threads = True
allow_reuse_address = True


