@classmethod
def detect_script(cls, ch: str) -> Optional[str]:
cp = ord(ch)
for script, ranges in cls.RANGES.items():
for lo, hi in ranges:
if lo <= cp <= hi:
return script
return None

@classmethod
def script_counts(cls, text: str) -> Dict[str, int]:
counts = defaultdict(int)
for ch in text:
s = cls.detect_script(ch)
if s:
counts[s] += 1
return dict(counts)


