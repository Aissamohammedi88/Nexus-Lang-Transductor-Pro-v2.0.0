@dataclass
class DetectionResult:
"""Résultat de détection."""
language: str
confidence: float
method: str
scores: Dict[str, float] = field(default_factory=dict)
script: str = ""
script_ratio: float = 0.0
text_length: int = 0
is_reliable: bool = True

def to_dict(self) -> Dict:
return asdict(self)


class LanguageDetector:
"""Détecteur multi-méthode."""

def __init__(self):
self.cache: Dict[str, DetectionResult] = {}
self.lock = threading.RLock()
self.stats = {"detections": 0, "cache_hits": 0}

def detect(self, text: str) -> DetectionResult:
"""Détecte la langue d'un texte."""
if not text or not text.strip():
return DetectionResult("unknown", 0.0, "empty")

text = text.strip()
if len(text) > Config.MAX_TEXT_SIZE:
text = text[:Config.MAX_TEXT_SIZE]

# Cache
key = hashlib.md5(text[:500].encode("utf-8")).hexdigest()
with self.lock:
if key in self.cache:
self.stats["cache_hits"] += 1
return self.cache[key]

# 1. Script Unicode
script_counts = UnicodeRanges.script_counts(text)
total_chars = sum(script_counts.values()) or 1
dominant_script = max(script_counts.items(), key=lambda x: x[1])[0] if script_counts else "Unknown"
script_ratio = script_counts.get(dominant_script, 0) / total_chars

# 2. Si script non-Latin, directement mappé
direct_map = {
"Cyrillic": "ru", "Greek": "el", "Arabic": "ar", "Hebrew": "he",
"Devanagari": "hi", "Bengali": "bn", "Tamil": "ta", "Telugu": "te",
"Thai": "th", "Hiragana": "ja", "Katakana": "ja", "CJK": "zh",
"Hangul": "ko", "Armenian": "hy", "Georgian": "ka", "Ethiopic": "am",
"Khmer": "km", "Myanmar": "my", "Tibetan": "bo", "Mongolian": "mn",
"Cherokee": "chr", "Sinhala": "si", "Lao": "lo",
}

if dominant_script != "Latin" and dominant_script in direct_map and script_ratio > 0.5:
lang = direct_map[dominant_script]
result = DetectionResult(
language=lang,
confidence=round(script_ratio, 3),
method="unicode_script",
script=dominant_script,
script_ratio=round(script_ratio, 3),
text_length=len(text),
)
with self.lock:
self.cache[key] = result
self.stats["detections"] += 1
return result

# 3. Latin ou mixte : scoring multi-méthode
candidates = list(Stopwords.languages())
scores = {}
for lang in candidates:
sw = Stopwords.score(text, lang)
ng = NgramSignatures.score(text, lang)
# Pondération : stopwords 70% + ngrams 30%
scores[lang] = sw * 0.7 + ng * 0.3

if not scores:
result = DetectionResult("unknown", 0.0, "no_candidates",
text_length=len(text))
else:
best_lang, best_score = max(scores.items(), key=lambda x: x[1])
is_reliable = best_score >= 0.05 and len(text) >= Config.MIN_TEXT_LENGTH
result = DetectionResult(
language=best_lang,
confidence=round(best_score, 3),
method="stopwords+ngrams",
scores={k: round(v, 4) for k, v in sorted(scores.items(), key=lambda x: -x[1])[:10]},
script=dominant_script,
script_ratio=round(script_ratio, 3),
text_length=len(text),
is_reliable=is_reliable,
)

with self.lock:
self.cache[key] = result
if len(self.cache) > Config.MAX_CACHE_SIZE:
self.cache = dict(list(self.cache.items())[-Config.MAX_CACHE_SIZE // 2:])
self.stats["detections"] += 1

return result

def detect_multi(self, text: str, separator: str = "\n\n") -> Dict:
"""Détection par blocs pour contenu mixte."""
global_result = self.detect(text)
blocks = []
for i, block in enumerate(text.split(separator)):
b = block.strip()
if len(b) < 10:
continue
r = self.detect(b)
blocks.append({
"index": i,
"preview": b[:100],
"language": r.language,
"confidence": r.confidence,
"method": r.method,
})

lang_counter = Counter(b["language"] for b in blocks)
is_mixed = len(lang_counter) > 1

return {
"global": global_result.to_dict(),
"blocks": blocks,
"languages_detected": dict(lang_counter),
"primary_language": global_result.language,
"is_mixed": is_mixed,
}

def stats(self) -> Dict:
with self.lock:
return dict(self.stats)


