function renderSimple(det, ms){
const conf = (det.confidence || 0);
const cls = conf > 0.15 ? 'ok' : conf > 0.05 ? 'warn' : 'danger';
const html =
'<div class="stat"><div class="l">Langue</div><div class="v ok">'+esc(det.language)+'</div></div>' +
'<div class="stat"><div class="l">Confiance</div><div class="v '+cls+'">'+Math.round(conf*100)+'%</div></div>' +
'<div class="stat"><div class="l">Méthode</div><div class="v">'+esc(det.method)+'</div></div>' +
'<div class="stat"><div class="l">Script</div><div class="v">'+esc(det.script || '-')+'</div></div>' +
'<div class="stat"><div class="l">Longueur</div><div class="v">'+det.text_length+'</div></div>' +
'<div class="stat"><div class="l">Durée</div><div class="v">'+(ms||0)+'ms</div></div>';
document.getElementById('stats').innerHTML = html;
document.getElementById('blocks').innerHTML = '';
document.getElementById('result').textContent = JSON.stringify(det, null, 2);
}

function renderMulti(d){
const g = d.global || {};
const conf = g.confidence || 0;
let html =
'<div class="stat"><div class="l">Langue principale</div><div class="v ok">'+esc(d.primary_language)+'</div></div>' +
'<div class="stat"><div class="l">Confiance</div><div class="v">'+Math.round(conf*100)+'%</div></div>' +
'<div class="stat"><div class="l">Blocs</div><div class="v">'+((d.blocks||[]).length)+'</div></div>' +
'<div class="stat"><div class="l">Mixte</div><div class="v '+(d.is_mixed?'warn':'ok')+'">'+(d.is_mixed?'OUI':'NON')+'</div></div>' +
'<div class="stat"><div class="l">Durée</div><div class="v">'+(d.duration_ms||0)+'ms</div></div>';
