class Logger:
"""Logger structuré."""

LEVELS = {"DEBUG": 0, "INFO": 1, "WARN": 2, "ERROR": 3}
current_level = "INFO"

@classmethod
def _write(cls, msg: str, level: str):
if cls.LEVELS.get(level, 1) < cls.LEVELS.get(cls.current_level, 1):
return
ts = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime())
line = f"[{ts}] [{level}] {msg}"
print(line, flush=True)
try:
with open(Config.LOG_FILE, "a", encoding="utf-8") as f:
f.write(line + "\n")
except OSError:
pass

@classmethod
def info(cls, msg): cls._write(msg, "INFO")
@classmethod
def warn(cls, msg): cls._write(msg, "WARN")
@classmethod
def error(cls, msg): cls._write(msg, "ERROR")
@classmethod
def debug(cls, msg): cls._write(msg, "DEBUG")


