class LocalTranslator:
"""Traducteur local (sans API externe)."""

def __init__(self):
self.cache: Dict[str, Dict] = {}
self.lock = threading.RLock()
self.stats = {"translations": 0, "cache_hits": 0}
self._load_cache()

def _load_cache(self):
if Config.CACHE_FILE.exists():
try:
self.cache = json.loads(Config.CACHE_FILE.read_text(encoding="utf-8"))
log.info(f"Cache chargé : {len(self.cache)} entrées")
except Exception as e:
log.warn(f"Cache load failed: {e}")

def _save_cache(self):
try:
Config.CACHE_FILE.write_text(
json.dumps(self.cache, ensure_ascii=False, indent=2),
encoding="utf-8"
)
except Exception as e:
log.warn(f"Cache save failed: {e}")

def translate(self, text: str, source: str, target: str) -> Dict:
"""Traduit un texte."""
if not text.strip():
return {"translation": "", "source": source, "target": target,
"method": "empty", "words_translated": 0, "words_total": 0}
if source == target:
return {"translation": text, "source": source, "target": target,
"method": "identity", "words_translated": 0, "words_total": 0}

key = hashlib.md5(f"{source}:{target}:{text[:300]}".encode("utf-8")).hexdigest()
with self.lock:
if key in self.cache:
self.stats["cache_hits"] += 1
return {**self.cache[key], "method": "cache"}

result = self._do_translate(text, source, target)
with self.lock:
self.cache[key] = result
self.stats["translations"] += 1
if len(self.cache) % 50 == 0:
self._save_cache()
if len(self.cache) > Config.MAX_CACHE_SIZE:
self.cache = dict(list(self.cache.items())[-Config.MAX_CACHE_SIZE // 2:])

return result

def _do_translate(self, text: str, source: str, target: str) -> Dict:
"""Traduction effective mot à mot."""
mapping = Dictionaries.get(source, target)

if not mapping:
return {
"translation": text,
"source": source, "target": target,
"method": "no_dictionary",
"words_translated": 0, "words_total": 0,
"note": f"Pas de dictionnaire {source} → {target}",
"available_pairs": [
f"{s}→{t}" for (s, t) in Dictionaries.available_pairs() if s == source
],
}

# Tokenizer simple
tokens = re.findall(r"\w+|\s+|[^\w\s]", text, re.UNICODE)
translated = []
words_translated = 0
words_total = 0

for token in tokens:
if not token.strip():
translated.append(token)
continue
words_total += 1
low = token.lower()
if low in mapping:
translated.append(mapping[low])
words_translated += 1
else:
translated.append(token)

return {
"translation": "".join(translated),
"source": source,
"target": target,
"method": "local_dictionary",
"words_translated": words_translated,
"words_total": words_total,
"coverage": round(words_translated / words_total, 3) if words_total else 0.0,
}

def stats(self) -> Dict:
with self.lock:
return dict(self.stats)


