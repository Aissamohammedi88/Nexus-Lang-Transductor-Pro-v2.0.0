class HtmlSegmenter:
"""Extrait le texte d'un HTML."""

TEXT_TAGS = ["p", "h1", "h2", "h3", "h4", "h5", "h6", "li", "td", "th",
"blockquote", "article", "section"]

@classmethod
def extract_text(cls, html: str) -> str:
html = re.sub(r"<script[^>]*>.*?</script>", " ", html, flags=re.DOTALL | re.IGNORECASE)
html = re.sub(r"<style[^>]*>.*?</style>", " ", html, flags=re.DOTALL | re.IGNORECASE)
text = re.sub(r"<[^>]+>", " ", html)
text = re.sub(r"&nbsp;", " ", text)
text = re.sub(r"&amp;", "&", text)
text = re.sub(r"&lt;", "<", text)
text = re.sub(r"&gt;", ">", text)
text = re.sub(r"\s+", " ", text)
return text.strip()

@classmethod
def extract_blocks(cls, html: str) -> List[Dict]:
html = re.sub(r"<script[^>]*>.*?</script>", " ", html, flags=re.DOTALL | re.IGNORECASE)
html = re.sub(r"<style[^>]*>.*?</style>", " ", html, flags=re.DOTALL | re.IGNORECASE)
blocks = []
for tag in cls.TEXT_TAGS:
pattern = rf"<{tag}[^>]*>(.*?)</{tag}>"
for i, m in enumerate(re.finditer(pattern, html, re.DOTALL | re.IGNORECASE)):
inner = re.sub(r"<[^>]+>", " ", m.group(1))
inner = re.sub(r"\s+", " ", inner).strip()
if len(inner) >= 15:
blocks.append({"tag": tag, "index": i, "text": inner})
return blocks

@classmethod
def extract_lang_attribute(cls, html: str) -> Optional[str]:
m = re.search(r'<html[^>]+lang=["\']([^"\']+)', html, re.IGNORECASE)
return m.group(1).split("-")[0].lower() if m else None


