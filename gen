@classmethod
def get(cls, lang: str) -> List[str]:
return cls.DATA.get(lang, [])

@classmethod
def score(cls, text: str, lang: str) -> float:
words = re.findall(r"\b\w+\b", text.lower())
if not words:
return 0.0
sw = set(cls.get(lang))
if not sw:
return 0.0
hits = sum(1 for w in words if w in sw)
return hits / len(words)

@classmethod
def languages(cls) -> List[str]:
return list(cls.DATA.keys())


