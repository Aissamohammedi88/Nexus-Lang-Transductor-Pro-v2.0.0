class NexusTransductor:
"""Moteur principal du système."""

def __init__(self):
self.detector = LanguageDetector()
self.translator = LocalTranslator()
self.start_time = time.time()
log.info(f"NexusTransductor v{Config.VERSION} initialisé")

def analyze_text(self, text: str) -> Dict:
"""Analyse un texte simple."""
start = time.time()
result = self.detector.detect(text)
duration = round((time.time() - start) * 1000, 2)
return {
"input": text[:200],
"detection": result.to_dict(),
"duration_ms": duration,
"local_mode": Config.LOCAL_MODE,
"timestamp": time.strftime("%Y-%m-%dT%H:%M:%S"),
}

def analyze_multi(self, text: str) -> Dict:
"""Analyse un texte multi-blocs."""
start = time.time()
result = self.detector.detect_multi(text)
result["duration_ms"] = round((time.time() - start) * 1000, 2)
result["local_mode"] = Config.LOCAL_MODE
return result

def analyze_url(self, url: str) -> Dict:
"""Analyse une URL."""
start = time.time()
try:
ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE
req = urllib.request.Request(url, headers={
"User-Agent": f"NexusTransductor/{Config.VERSION}"
})
with urllib.request.urlopen(req, timeout=15, context=ctx) as resp:
html = resp.read(500000).decode("utf-8", errors="ignore")

# Extraction
lang_attr = HtmlSegmenter.extract_lang_attribute(html)
text = HtmlSegmenter.extract_text(html)
blocks = HtmlSegmenter.extract_blocks(html)

# Détection globale
global_result = self.detector.detect(text)

# Détection par bloc
block_results = []
for b in blocks[:50]:
r = self.detector.detect(b["text"])
block_results.append({
"tag": b["tag"],
"index": b["index"],
"preview": b["text"][:100],
"language": r.language,
"confidence": r.confidence,
})

lang_counter = Counter(b["language"] for b in block_results)

return {
"url": url,
"html_lang": lang_attr,
"global_detection": global_result.to_dict(),
"blocks_analyzed": len(block_results),
"languages_found": dict(lang_counter),
"primary_language": lang_counter.most_common(1)[0][0] if lang_counter else "unknown",
"is_mixed": len(lang_counter) > 1,
"blocks": block_results,
"duration_ms": round((time.time() - start) * 1000, 2),
"local_mode": Config.LOCAL_MODE,
}
except Exception as e:
log.error(f"URL analysis failed: {e}")
return {
"url": url,
"error": str(e)[:200],
"duration_ms": round((time.time() - start) * 1000, 2),
}

def translate(self, text: str, source: str, target: str) -> Dict:
"""Traduit un texte."""
start = time.time()
result = self.translator.translate(text, source, target)
result["duration_ms"] = round((time.time() - start) * 1000, 2)
result["local_mode"] = Config.LOCAL_MODE
return result

def stats(self) -> Dict:
return {
"version": Config.VERSION,
"build": Config.BUILD,
"author": Config.AUTEUR,
"license": Config.LICENCE,
"protocol": Config.PROTOCOLE,
"local_mode": Config.LOCAL_MODE,
"uptime_sec": round(time.time() - self.start_time, 1),
"detection": self.detector.stats(),
"translation": self.translator.stats(),
"languages_available": len(Stopwords.languages()),
"dictionary_pairs": len(Dictionaries.available_pairs()),
}


